{
  "name": "qcm-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:nix": "nix-shell --run 'npx prisma generate' && next build",
    "start": "next start",
    "lint": "eslint src",
    "db:generate": "nix-shell --run 'npx prisma generate'",
    "db:push": "nix-shell --run 'npx prisma db push'",
    "db:migrate": "nix-shell --run 'npx prisma migrate dev'",
    "db:studio": "nix-shell --run 'npx prisma studio'",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "7.9.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8",
    "prisma": "6.18.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
